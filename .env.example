# Copy this file to ".env" and fill in LOCAL values only. Never commit .env.
# These are example local-development values, not production secrets.

# PostgreSQL connection used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Matches docker-compose.yml defaults below:
DATABASE_URL="postgresql://school:school_dev_password@localhost:5433/school_saas?schema=public"

# Local Postgres container settings (used by docker-compose.yml only)
POSTGRES_USER=school
POSTGRES_PASSWORD=school_dev_password
POSTGRES_DB=school_saas
POSTGRES_PORT=5433

# --- Phase 2 API ---
PORT=4000
# Long random string in real deployments; never commit a real secret.
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Notification provider adapter: "log" (dev stub, records acceptance, sends
# nothing externally) — real WhatsApp/push adapters arrive in Phase 4.
NOTIFICATION_PROVIDER=log
WORKER_POLL_MS=2000
DUPLICATE_SCAN_WINDOW_SEC=120

# --- Phase 4 providers (all optional; keep real values ONLY in .env) ---
# WhatsApp Cloud API (Meta): set NOTIFICATION_PROVIDER=whatsapp to use it.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_NOTICE_TEMPLATE=school_notice
WHATSAPP_TEMPLATE_LANG=en
# FCM push: path to a Firebase service-account JSON (never commit the file).
FCM_SERVICE_ACCOUNT_PATH=
